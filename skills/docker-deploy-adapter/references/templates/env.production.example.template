# ==============================================================================
# Production Environment Configuration Template (.env.production.example)
# INSTRUCTIONS:
# 1. Copy this file to .env.production on your remote deployment target:
#    cp .env.production.example .env.production
# 2. Fill in all placeholder values marked with CHANGEME.
# 3. DO NOT commit .env.production to version control (ensure it is in .gitignore).
# ==============================================================================

# Application & Domain Settings
NODE_ENV=production
APP_ENV=production
APP_DOMAIN=app.yourdomain.com
PORT=3000

# Security & Encryption Secrets (Generate via: openssl rand -base64 32)
SECRET_KEY=CHANGEME_GENERATE_WITH_OPENSSL_RAND_BASE64_32
JWT_SECRET=CHANGEME_GENERATE_WITH_OPENSSL_RAND_BASE64_32

# Database Configuration (Internal PostgreSQL container or external managed DB)
POSTGRES_DB=app_production
POSTGRES_USER=app_user
POSTGRES_PASSWORD=CHANGEME_STRONG_RANDOM_PASSWORD
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@db:5432/${POSTGRES_DB}?sslmode=prefer

# Cache & Redis (if applicable)
# REDIS_URL=redis://cache:6379/0

# External APIs & Integrations (if applicable)
# THIRD_PARTY_API_KEY=CHANGEME
